# Public statistics: any site (including the Economy Graph web app) may read them.
/*
  Access-Control-Allow-Origin: *

# The app checks manifest.json first, so keep it fresh; data files change at most weekly.
/manifest.json
  Cache-Control: public, max-age=300

/us/*
  Cache-Control: public, max-age=3600

/kr/*
  Cache-Control: public, max-age=3600
